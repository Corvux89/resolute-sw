{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Launch app.py",
      "program": "${workspaceFolder}/app.py"
    },
     {
        "name": "Python: FastAPI",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",          
        "args": [
            "app:app", 
            "--reload",
            "--reload-include", "*.js",
            "--port",
            "5000" 
        ]
    }
  ]
}
